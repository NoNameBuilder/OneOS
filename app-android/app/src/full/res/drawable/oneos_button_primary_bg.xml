<?xml version="1.0" encoding="utf-8"?>
<!-- OneOS.Button.Primary: a 26dp-radius pill in ?attr/colorPrimary with a light ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/oneos_ripple_on_primary">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/oneos_button_primary_fill" />
            <corners android:radius="@dimen/oneos_button_radius" />
        </shape>
    </item>
</ripple>
