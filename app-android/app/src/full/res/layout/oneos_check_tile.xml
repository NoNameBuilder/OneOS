<?xml version="1.0" encoding="utf-8"?>
<!-- One readiness check (Main.dc.html "Your phone is ready" grid): icon, name,
     value. Cards.bindCheckTile tints the icon and the tile by Level. TalkBack
     reads the tile as one item. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/OneOS.Tile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:screenReaderFocusable="true">

    <ImageView
        android:id="@+id/oneos_tile_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        app:tint="@color/oneos_ok_text" />

    <TextView
        android:id="@+id/oneos_tile_title"
        style="@style/OneOS.Text.Title.Tile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/oneos_tile_value"
        style="@style/OneOS.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

</LinearLayout>
