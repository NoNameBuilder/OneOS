<?xml version="1.0" encoding="utf-8"?>
<!-- One system (SystemPicker.dc.html): device glyph, name and state badge,
     variant, blurb, fact chips, then its buttons. SystemsFragment binds it.
     The spacer lets two cards side by side (inner screen) share one height
     with their buttons at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/OneOS.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/systems_glyph"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_oneos_system_0" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.fahadali.oneos.ui.ChipFlowLayout
                android:id="@+id/systems_name_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/systems_name"
                    style="@style/OneOS.Systems.Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true" />

                <TextView
                    android:id="@+id/systems_badge"
                    style="@style/OneOS.Systems.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

            </com.fahadali.oneos.ui.ChipFlowLayout>

            <TextView
                android:id="@+id/systems_variant"
                style="@style/OneOS.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/systems_blurb"
                style="@style/OneOS.Systems.Blurb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </LinearLayout>

    <com.fahadali.oneos.ui.ChipFlowLayout
        android:id="@+id/systems_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/systems_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <Button
            android:id="@+id/systems_download"
            style="@style/OneOS.Systems.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/systems_download" />

        <Button
            android:id="@+id/systems_have_file"
            style="@style/OneOS.Systems.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/systems_have_file" />

        <Button
            android:id="@+id/systems_primary"
            style="@style/OneOS.Systems.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
