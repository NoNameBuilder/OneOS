<?xml version="1.0" encoding="utf-8"?>
<!-- A card screen behind Advanced (CardsFragment): One UI cards in one
     scrolling column under the screen's collapsing bar. The cards are added
     to oneos_cards_column in code (Cards, CardRows). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/oneos_cards_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/oneos_cards_column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/oneos_card_inset"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/oneos_card_inset"
        android:paddingBottom="16dp" />

</androidx.core.widget.NestedScrollView>
