<?xml version="1.0" encoding="utf-8"?>
<!-- Setting up (SettingUp.dc.html): the ring with percent and time left, the
     title, the three steps, the "keep OneOS open" note, and Details (the
     technical steps). SetupProgressFragment binds it from PrepareJob.State. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/setup_column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/oneos_card_inset"
        android:paddingEnd="@dimen/oneos_card_inset"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/setup_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="26dp">

            <!-- TalkBack reads the ring as one item: "42 percent done. About 9 min left". -->
            <FrameLayout
                android:id="@+id/setup_ring_box"
                android:layout_width="196dp"
                android:layout_height="196dp"
                android:importantForAccessibility="yes"
                android:screenReaderFocusable="true">

                <com.fahadali.oneos.ui.SetupRingView
                    android:id="@+id/setup_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <TextView
                        android:id="@+id/setup_percent"
                        style="@style/OneOS.Setup.Percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/setup_eta"
                        style="@style/OneOS.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center" />

                </LinearLayout>

            </FrameLayout>

            <TextView
                android:id="@+id/setup_title"
                style="@style/OneOS.Setup.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:accessibilityHeading="true"
                android:accessibilityLiveRegion="polite" />

            <TextView
                android:id="@+id/setup_subtitle"
                style="@style/OneOS.Text.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center" />

        </LinearLayout>

        <!-- The three user steps (setup_step.xml rows, added in code). -->
        <LinearLayout
            android:id="@+id/setup_steps"
            style="@style/OneOS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <LinearLayout
            android:id="@+id/setup_keep_open"
            style="@style/OneOS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/oneos_card_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_oneos_plug" />

            <TextView
                style="@style/OneOS.Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/setup_keep_open"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Details: a list card added in code (Cards.section, rows). -->
        <LinearLayout
            android:id="@+id/setup_details_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/oneos_card_gap"
            android:orientation="vertical" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
