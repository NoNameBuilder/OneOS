<?xml version="1.0" encoding="utf-8"?>
<!-- One way back to One UI in the Switch sheet (SwitchSheet.dc.html): a 40dp
     chip with the icon, what to do, and one line. TalkBack reads it as one
     item. Filled by SwitchConfirm. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/home_sheet_tile_bg"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp"
    android:screenReaderFocusable="true">

    <FrameLayout
        android:id="@+id/way_chip"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/home_way_chip_bg"
        android:importantForAccessibility="no">

        <ImageView
            android:id="@+id/way_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/way_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/way_line"
            style="@style/OneOS.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</LinearLayout>
