<?xml version="1.0" encoding="utf-8"?>
<!-- Choose a system: the hero (title and the phone's name), then one card per
     system of this phone (systems_card.xml), added by SystemsFragment. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/systems_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/systems_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="150dp"
            android:orientation="vertical"
            android:paddingStart="@dimen/oneos_screen_gutter"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/oneos_screen_gutter"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/systems_hero_title"
                style="@style/OneOS.Systems.HeroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/systems_title" />

            <TextView
                android:id="@+id/systems_hero_subtitle"
                style="@style/OneOS.Text.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/systems_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/oneos_card_inset"
            android:paddingEnd="@dimen/oneos_card_inset" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
