<?xml version="1.0" encoding="utf-8"?>
<!-- Findings preview: summary and file list as preference rows, and a fixed
     footer with Share and Save to Downloads. -->
<dev.oneuiproject.oneui.layout.ToolbarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:expandable="true"
    app:expanded="false">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/findings_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        app:layout_location="footer">

        <Button
            android:id="@+id/findings_save"
            style="@style/OneUI.ButtonStyleTransparent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/findings_save" />

        <Button
            android:id="@+id/findings_share"
            style="@style/OneUI.ButtonStyleColored"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/findings_share" />

    </LinearLayout>

</dev.oneuiproject.oneui.layout.ToolbarLayout>
