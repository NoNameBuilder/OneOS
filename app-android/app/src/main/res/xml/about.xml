<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/about_cat_app">
        <Preference
            android:key="version"
            android:selectable="false"
            android:title="@string/about_version_title" />
        <Preference
            android:selectable="false"
            android:summary="@string/about_what_summary"
            android:title="@string/about_what_title" />
        <Preference
            android:selectable="false"
            android:summary="@string/about_version_scope_summary"
            android:title="@string/about_version_scope_title" />
        <Preference
            android:selectable="false"
            android:summary="@string/about_tested_summary"
            android:title="@string/about_tested_title" />
